{
  "schemaVersion": 1,
  "id": "authsecured",
  "version": "${version}",
  "name": "AuthSecured",
  "description": "Server-side authentication mod with Argon2id, SQLite/PostgreSQL, sessions and pre-auth restrictions.",
  "authors": ["touchfalls"],
  "license": "MIT",
  "environment": "server",
  "entrypoints": {
    "server": [
      "com.example.authsecured.fabric.AuthSecuredFabricMod"
    ]
  },
  "mixins": [
    "authsecured.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "fabric-api": "*",
    "minecraft": "=${minecraft_version}",
    "java": ">=${java_version}"
  }
}
